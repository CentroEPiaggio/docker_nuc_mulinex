<?xml version="1.0"?>
<sdf version="1.7">
  <world name="demo0_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
   
    <scene>
      <ambient>0.75 0.75 0.75 1</ambient>
      <background>0.85 0.90 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -3.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.0 0.10 1.50</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.0 0.10 1.50</size></box></geometry><material><ambient>0.30 0.45 0.65 1</ambient><diffuse>0.30 0.45 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static>
      <pose>0 3.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.0 0.10 1.50</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.0 0.10 1.50</size></box></geometry><material><ambient>0.30 0.45 0.65 1</ambient><diffuse>0.30 0.45 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-4.0 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.10 6.0 1.50</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.10 6.0 1.50</size></box></geometry><material><ambient>0.30 0.45 0.65 1</ambient><diffuse>0.30 0.45 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>4.0 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.10 6.0 1.50</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.10 6.0 1.50</size></box></geometry><material><ambient>0.30 0.45 0.65 1</ambient><diffuse>0.30 0.45 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <model name="demo_table">
      <static>true</static>
      <pose>-0.80 1.00 0.38 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.20 0.60 0.76</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.20 0.60 0.76</size></box></geometry><material><ambient>0.45 0.25 0.10 1</ambient><diffuse>0.45 0.25 0.10 1</diffuse></material></visual>
      </link>
    </model>

    <model name="demo_cabinet">
      <static>true</static>
      <pose>0.30 -1.00 0.50 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.50 1.20 1.00</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.50 1.20 1.00</size></box></geometry><material><ambient>0.20 0.55 0.35 1</ambient><diffuse>0.20 0.55 0.35 1</diffuse></material></visual>
      </link>
    </model>

    <model name="demo_low_barrier">
      <static>true</static>
      <pose>1.55 -0.55 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.00 0.30 0.50</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.00 0.30 0.50</size></box></geometry><material><ambient>0.65 0.30 0.20 1</ambient><diffuse>0.65 0.30 0.20 1</diffuse></material></visual>
      </link>
    </model>

    <model name="interview_person">
      <static>true</static>
      <pose>2.20 1.20 0 0 0 0</pose>
      <link name="body">
        <collision name="body_collision">
          <pose>0 0 0.65 0 0 0</pose>
          <geometry><cylinder><radius>0.20</radius><length>1.30</length></cylinder></geometry>
        </collision>
        <visual name="body_visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.20</radius><length>1.30</length></cylinder></geometry>
          <material><ambient>0.15 0.30 0.75 1</ambient><diffuse>0.15 0.30 0.75 1</diffuse></material>
        </visual>
        <visual name="head_visual">
          <pose>0 0 1.55 0 0 0</pose>
          <geometry><sphere><radius>0.16</radius></sphere></geometry>
          <material><ambient>0.85 0.65 0.50 1</ambient><diffuse>0.85 0.65 0.50 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="interview_marker">
      <static>true</static>
      <pose>1.35 1.20 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.95 0.80 0.10 1</ambient><diffuse>0.95 0.80 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
