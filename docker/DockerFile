ARG BASE_IMAGE=osrf/ros
ARG BASE_TAG=humble-desktop-full

FROM ${BASE_IMAGE}:${BASE_TAG}

ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,sharing=locked,target=/var/cache/apt \
    --mount=type=cache,sharing=locked,target=/var/lib/apt \
    apt-get update && apt-get install --no-install-recommends -qqy \
    alsa-utils \
    chrony \
    espeak-ng \
    ffmpeg \
    git \
    iproute2 \
    iputils-ping \
    libeigen3-dev \
    libyaml-cpp-dev \
    nano \
    nautilus \
    pipx \
    pulseaudio-utils \
    python3-colcon-common-extensions \
    python3-numpy \
    python3-pip \
    python3-yaml \
    ros-$ROS_DISTRO-camera-info-manager \
    ros-$ROS_DISTRO-diagnostic-aggregator \
    ros-$ROS_DISTRO-diagnostic-updater \
    ros-$ROS_DISTRO-ign-ros2-control \
    ros-$ROS_DISTRO-image-transport-plugins \
    ros-$ROS_DISTRO-joint-state-publisher \
    ros-$ROS_DISTRO-joint-state-publisher-gui \
    ros-$ROS_DISTRO-joy \
    ros-$ROS_DISTRO-nav2-bringup \
    ros-$ROS_DISTRO-nav2-simple-commander \
    ros-$ROS_DISTRO-navigation2 \
    ros-$ROS_DISTRO-pinocchio \
    ros-$ROS_DISTRO-plotjuggler \
    ros-$ROS_DISTRO-plotjuggler-ros \
    ros-$ROS_DISTRO-realsense2-camera \
    ros-$ROS_DISTRO-realsense2-description \
    ros-$ROS_DISTRO-rmw-cyclonedds-cpp \
    ros-$ROS_DISTRO-robot-localization \
    ros-$ROS_DISTRO-ros-gz \
    ros-$ROS_DISTRO-ros2-control \
    ros-$ROS_DISTRO-ros2-controllers \
    ros-$ROS_DISTRO-rosbag2-storage-mcap \
    ros-$ROS_DISTRO-rqt-image-view \
    ros-$ROS_DISTRO-rviz2 \
    ros-$ROS_DISTRO-slam-toolbox \
    ros-$ROS_DISTRO-teleop-twist-joy \
    ros-$ROS_DISTRO-teleop-twist-keyboard \
    ros-$ROS_DISTRO-tf2-tools \
    ros-$ROS_DISTRO-topic-tools \
    ros-$ROS_DISTRO-twist-mux \
    ros-$ROS_DISTRO-xacro \
    sudo \
    tmux \
    usbutils \
    xauth \
    xterm

ARG MYUID=1000
ARG MYGID=1000
ARG USER=ros

RUN OLD_USER=$(awk -v uid="$MYUID" -F ':' '$3==uid {print $1}' /etc/passwd) \
    && if [ -z "${OLD_USER}" ]; then \
         addgroup --gid ${MYGID} ${USER} \
         && adduser --gecos "ROS User" --disabled-password --uid ${MYUID} --gid ${MYGID} ${USER}; \
       else \
         usermod -l ${USER} ${OLD_USER} \
         && usermod -d /home/${USER} -m ${USER}; \
       fi \
    && usermod -a -G dialout,audio,video ${USER} \
    && echo "${USER} ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/99-demo0 \
    && chmod 0440 /etc/sudoers.d/99-demo0 \
    && mkdir -p /home/${USER} \
    && chown -R ${USER}:${MYGID} /home/${USER}

ENV USER=${USER}
ENV HOME=/home/${USER}
ENV WORKSPACE=mulinex_ws
WORKDIR /home/${USER}/${WORKSPACE}

ENV PIP_BREAK_SYSTEM_PACKAGES=1

COPY docker/.config/entrypoint.sh /ros_entrypoint.sh
RUN chmod 755 /ros_entrypoint.sh && chown ${USER}:${MYGID} /ros_entrypoint.sh

USER ${USER}

RUN printf '%s\n' \
    '' \
    'source /opt/ros/$ROS_DISTRO/setup.bash' \
    'if [ -f "$HOME/$WORKSPACE/install/setup.bash" ]; then source "$HOME/$WORKSPACE/install/setup.bash"; fi' \
    'source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash' \
    >> ~/.bashrc

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
